APP_NAME="BK Packages ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://erp.bkpackages.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Production PostgreSQL Connection (Neon.tech / Railway / Self-hosted PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bk_packages_erp
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

